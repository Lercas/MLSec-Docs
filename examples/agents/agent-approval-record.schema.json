{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents/examples/agent-approval-record.schema.json",
  "title": "Agent Approval Record",
  "description": "Проектный пример формы approval evidence (milksec-agent-examples/1.0), JSON Schema Draft 2020-12. Проверяет структуру, enum и условные поля, но не авторизует действие: не сравнивает даты, не проверяет актуальность делегации, связи между списками согласующих, личность людей и точные аргументы. Semantic validation и совместимость описаны в README.md.",
  "$comment": "Исправление аннотаций не меняет допустимые экземпляры. additionalProperties=false: action binding хранится отдельным evidence artifact, а изменение формы требует новой версии контракта.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_type": {
            "const": "two_person"
          }
        },
        "required": [
          "approval_type"
        ]
      },
      "then": {
        "required": [
          "approved_by",
          "approver_ids"
        ],
        "properties": {
          "approved_by": {
            "minItems": 2,
            "uniqueItems": true
          },
          "approver_ids": {
            "minItems": 2,
            "uniqueItems": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_status": {
            "const": "approved"
          }
        },
        "required": [
          "approval_status"
        ]
      },
      "then": {
        "required": [
          "approved_at",
          "approver_id",
          "approved_by",
          "approver_ids",
          "approval_scope",
          "action_id",
          "expires_at"
        ],
        "properties": {
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "approver_id": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "minItems": 1
          },
          "approver_ids": {
            "minItems": 1
          },
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "denied_at": {
            "type": "null"
          },
          "denied_by": {
            "type": "null"
          },
          "denied_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_status": {
            "const": "requested"
          }
        },
        "required": [
          "approval_status"
        ]
      },
      "then": {
        "required": [
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_status": {
            "const": "denied"
          }
        },
        "required": [
          "approval_status"
        ]
      },
      "then": {
        "required": [
          "denied_at",
          "denied_by",
          "denied_reason"
        ],
        "properties": {
          "denied_at": {
            "type": "string",
            "format": "date-time"
          },
          "denied_by": {
            "$ref": "#/$defs/human_approval_actor"
          },
          "denied_reason": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "null"
          },
          "approver_id": {
            "type": "null"
          },
          "approved_by": {
            "maxItems": 0
          },
          "approver_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "privileged_action": {
            "const": true
          }
        },
        "required": [
          "privileged_action"
        ]
      },
      "then": {
        "required": [
          "explicit_approval_required"
        ],
        "properties": {
          "explicit_approval_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_type": {
            "const": "denial"
          }
        },
        "required": [
          "approval_type"
        ]
      },
      "then": {
        "properties": {
          "approval_status": {
            "const": "denied"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_type": {
            "const": "revocation"
          }
        },
        "required": [
          "approval_type"
        ]
      },
      "then": {
        "properties": {
          "approval_status": {
            "const": "revoked"
          }
        }
      }
    }
  ],
  "required": [
    "approval_id",
    "agent_id",
    "action_id",
    "requested_at",
    "approved_at",
    "approver_id",
    "expires_at",
    "requested_by",
    "approved_by",
    "approver_ids",
    "approval_type",
    "approval_status",
    "approval_scope",
    "action_summary",
    "risk_level",
    "privileged_action",
    "explicit_approval_required",
    "policy_reference",
    "justification",
    "conditions",
    "denied_at",
    "denied_by",
    "denied_reason",
    "revocation",
    "evidence_uri",
    "related_event_ids"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "description": "Уникальный идентификатор approval record."
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Идентификатор агента, для которого выдано согласование. Должен совпадать с `approval_scope.agent_id` и runtime event."
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "description": "Стабильный идентификатор конкретного действия из action policy или runtime event."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Время запроса согласования в UTC."
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Время подтверждения в UTC. Для `approval_status=approved` обязательно непустое значение."
    },
    "approver_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Основной согласующий. Для `approval_status=approved` обязательно непустое значение; для `two_person` должен входить в `approver_ids`."
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Срок действия согласования в UTC. Для запрошенного или подтверждённого согласования обязателен, чтобы ограничить повторное использование."
    },
    "requested_by": {
      "$ref": "#/$defs/approval_actor",
      "description": "Субъект, запросивший согласование."
    },
    "approved_by": {
      "type": "array",
      "description": "Люди, подтвердившие действие. Для `two_person` должно быть не менее двух записей.",
      "items": {
        "$ref": "#/$defs/human_approval_actor"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "approver_ids": {
      "type": "array",
      "description": "Машинно проверяемый список идентификаторов согласующих. Для `two_person` требуется минимум два разных значения.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "approval_type": {
      "type": "string",
      "description": "Тип согласования.",
      "enum": [
        "single_approver",
        "two_person",
        "time_bound",
        "conditional",
        "denial",
        "revocation"
      ]
    },
    "approval_status": {
      "type": "string",
      "description": "Текущий статус согласования.",
      "enum": [
        "requested",
        "approved",
        "denied",
        "expired",
        "revoked"
      ]
    },
    "approval_scope": {
      "$ref": "#/$defs/approval_scope",
      "description": "Область действия согласования. Она должна быть уже или равна delegated authority и не должна расширяться до `all` без отдельного обоснования."
    },
    "action_summary": {
      "type": "string",
      "minLength": 1,
      "description": "Краткое описание действия без raw sensitive content."
    },
    "risk_level": {
      "type": "string",
      "description": "Уровень риска действия для агентного сценария; не заменяет risk taxonomy из базовых документов.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "privileged_action": {
      "type": "boolean",
      "description": "Признак privileged action: чувствительное чтение, запись через privileged connector, bulk, внешнее воздействие или действие с legal/financial/security-sensitive impact."
    },
    "explicit_approval_required": {
      "type": "boolean",
      "description": "Явный признак того, что действие нельзя выполнять без записи согласования. Для privileged action должен быть true."
    },
    "policy_reference": {
      "type": "object",
      "description": "Ссылка на policy, rule и версию policy.",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "rule_id"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "justification": {
      "type": [
        "string",
        "null"
      ],
      "description": "Обоснование согласования или отказа без raw sensitive content."
    },
    "conditions": {
      "type": "array",
      "description": "Условия conditional approval.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "description",
          "must_be_satisfied_before_execution"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "must_be_satisfied_before_execution": {
            "type": "boolean"
          }
        }
      }
    },
    "denied_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Время отказа в UTC. Для `approval_status=denied` обязательно непустое значение."
    },
    "denied_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/human_approval_actor"
        },
        {
          "type": "null"
        }
      ],
      "description": "Человек, отказавший в согласовании. Для `approval_status=denied` обязательно."
    },
    "denied_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Причина отказа. Для `approval_status=denied` обязательно непустое значение."
    },
    "revocation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Данные об отзыве approval.",
      "additionalProperties": false,
      "required": [
        "revoked_at",
        "revoked_by",
        "revocation_reason"
      ],
      "properties": {
        "revoked_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_by": {
          "$ref": "#/$defs/approval_actor"
        },
        "revocation_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_uri": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri-reference",
      "description": "Ссылка на approval evidence. Не должна содержать секреты или персональные данные."
    },
    "related_event_ids": {
      "type": "array",
      "description": "Связанные события исполнения, например `approval_required`, `human_approval_recorded`, `approval_revoked` или `tool_call_executed`.",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "approval_scope": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope_type": {
                "const": "all"
              }
            },
            "required": [
              "scope_type"
            ]
          },
          "then": {
            "required": [
              "broad_scope_justification"
            ],
            "properties": {
              "broad_scope_justification": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        }
      ],
      "required": [
        "scope_type",
        "agent_id",
        "action_ids",
        "workflow_id",
        "action_names",
        "tool_names",
        "connector_ids",
        "max_records",
        "external_side_effect_allowed",
        "data_classification_allowed",
        "broad_scope_justification"
      ],
      "properties": {
        "scope_type": {
          "type": "string",
          "description": "Область действия согласования. `all` допустимо только с отдельным обоснованием.",
          "enum": [
            "specific_action",
            "workflow",
            "all"
          ]
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "all"
            }
          },
          "minItems": 1
        },
        "workflow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "all"
            }
          },
          "minItems": 1
        },
        "tool_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "connector_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "max_records": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "external_side_effect_allowed": {
          "type": "boolean"
        },
        "data_classification_allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "minItems": 1
        },
        "broad_scope_justification": {
          "type": [
            "string",
            "null"
          ],
          "description": "Отдельное обоснование для `scope_type=all`. Для точечных согласований должно быть null."
        }
      }
    },
    "approval_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "human_user",
            "service_account",
            "agent",
            "system"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "description": "Псевдонимизированный идентификатор. Не хранит персональные данные в raw form."
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "human_approval_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "role"
      ],
      "properties": {
        "actor_type": {
          "const": "human_user"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "description": "Псевдонимизированный идентификатор согласующего. Не хранит персональные данные в raw form."
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
